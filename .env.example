NODE_ENV=development
# 3000 fica com o e-commerce-RF
PORT=3001

# Database (docker compose up -d postgres)
DATABASE_URL=postgresql://ledger:ledger@localhost:5433/ledger_dev

# Operator access to /platform/* and /ledger/* (Authorization: Bearer <token>).
# Without it those routes reject every request.
PLATFORM_ADMIN_TOKEN=dev-platform-token-troque-em-producao

# Simulated rails (ADR 0001): mounts /simulator/*. Never enable in production.
SIMULATORS_ENABLED=true

# Background jobs, in milliseconds; 0 disables
PAYMENTS_EXPIRY_INTERVAL_MS=10000
WEBHOOK_DISPATCH_INTERVAL_MS=2000

# Card Vault (ADR 0002): AES-256 key for card numbers at rest, 32 bytes base64.
# Generate one with: openssl rand -base64 32. Losing it makes stored cards unreadable.
VAULT_ENCRYPTION_KEY=
VAULT_PURGE_INTERVAL_MS=60000
# Releases due receivables (D+N) and retries pending payouts
SETTLEMENT_INTERVAL_MS=60000
# Cross-checks ledger, payments, refunds, payouts and schedule; logs what disagrees
RECONCILIATION_INTERVAL_MS=3600000
